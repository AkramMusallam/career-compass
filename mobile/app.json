{
  "expo": {
    "name": "Career Compass",
    "slug": "career-compass-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "اسمح للتطبيق باستخدام الميكروفون لتسجيل إجابات المقابلة.",
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "backgroundColor": "#0f172a"
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.careercompass.mobile",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.careercompass.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "0cc49053-a923-46d5-990b-ad5251c53d07"
      }
    },
    "owner": "akram3005"
  }
}
