{
  "expo": {
    "name": "Career Compass",
    "slug": "career-compass-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "plugins": [["expo-av", { "microphonePermission": "اسمح للتطبيق باستخدام الميكروفون لتسجيل إجابات المقابلة." }]],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      }
    }
  }
}
