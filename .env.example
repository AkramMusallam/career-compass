# Production & Docker Compose environment template.
# Copy to `.env` in the repository root (used by `docker-compose.prod.yml`)
# and replace every secret value before starting production containers.
# Note: Use URL-safe alphanumeric/hex secrets for DB/Redis passwords
# (for example: `openssl rand -hex 24`) because they are embedded into MONGO_URI / REDIS_URL.

ENV=production
DOMAIN_NAME=your-domain.com

# Required security & CORS settings (fail-closed in docker-compose.prod.yml)
JWT_SECRET_KEY=
CORS_ORIGINS=https://your-domain.com
FRONTEND_BASE_URL=https://your-domain.com
TRUSTED_PROXY_IPS=127.0.0.1

# Required MySQL credentials (application uses non-root MYSQL_USER)
MYSQL_ROOT_PASSWORD=
MYSQL_USER=career_user
MYSQL_PASSWORD=

# Required MongoDB root credentials
MONGO_INITDB_ROOT_USERNAME=career_mongo
MONGO_INITDB_ROOT_PASSWORD=

# Required Redis password
REDIS_PASSWORD=

# AI Engine
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=

# Optional SMTP notifications
EMAIL_NOTIFICATIONS_ENABLED=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=1
SMTP_FROM_EMAIL=no-reply@career-compass.app
SMTP_FROM_NAME=Career Compass

# Optional Stripe / PayPal billing (Phase 3)
# ENFORCE_SUBSCRIPTION_QUOTAS=1 (set to 0 while subscriptions are disabled/Coming Soon)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox
