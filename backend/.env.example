ENV=development

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# MySQL (اتركها كما هي واستخدم USE_SQLITE_FALLBACK=1 للتطوير السريع بدون MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=career_compass
USE_SQLITE_FALLBACK=0
SQLITE_PATH=career_compass.db

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=career_compass
USE_MONGOMOCK=0

# رفع الملفات
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://scarce-drove-amendable.ngrok-free.dev

# AI Engine / Ollama Model
OLLAMA_MODEL=career-model

# Batch 5.4 — مهام مجدولة (Celery + Redis)
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=0
WEEKLY_EMAIL_DAY_OF_WEEK=monday
WEEKLY_EMAIL_HOUR=8
WEEKLY_EMAIL_MINUTE=0

# Batch 5.5 — خدمة البريد الإلكتروني (SMTP) للتنبيهات الأسبوعية
# اتركها EMAIL_NOTIFICATIONS_ENABLED=0 في التطوير/الاختبار — لا يُرسَل أي بريد فعلي إلا بعد
# ضبط بيانات اعتماد SMTP حقيقية وتفعيلها صراحة.
EMAIL_NOTIFICATIONS_ENABLED=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=1
SMTP_FROM_EMAIL=no-reply@career-compass.app
SMTP_FROM_NAME=Career Compass
FRONTEND_BASE_URL=http://localhost:5173
