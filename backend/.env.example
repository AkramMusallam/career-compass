ENV=development

# JWT (Generate a strong random secret in production, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# MySQL (اتركها كما هي واستخدم USE_SQLITE_FALLBACK=1 للتطوير السريع بدون MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=career_compass
USE_SQLITE_FALLBACK=0
SQLITE_PATH=career_compass.db

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=career_compass
USE_MONGOMOCK=0

# رفع الملفات
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# CORS & Browser Extension Allowlist
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_EXTENSION_IDS=

# AI Engine / Ollama Model
OLLAMA_MODEL=llama3.2

# Batch 5.4 — مهام مجدولة (Celery + Redis)
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=0
WEEKLY_EMAIL_DAY_OF_WEEK=monday
WEEKLY_EMAIL_HOUR=8
WEEKLY_EMAIL_MINUTE=0

# Batch 5.5 — خدمة البريد الإلكتروني (SMTP) للتنبيهات الأسبوعية
# اتركها EMAIL_NOTIFICATIONS_ENABLED=0 في التطوير/الاختبار — لا يُرسَل أي بريد فعلي إلا بعد
# ضبط بيانات اعتماد SMTP حقيقية وتفعيلها صراحة.
EMAIL_NOTIFICATIONS_ENABLED=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=1
SMTP_FROM_EMAIL=no-reply@career-compass.app
SMTP_FROM_NAME=Career Compass
FRONTEND_BASE_URL=http://localhost:5173

# Phase 3 — Monetization & Payment Gateways (Stripe / PayPal)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox

# Trusted Reverse Proxies (IPs or CIDR subnets, e.g., Docker bridge 172.16.0.0/12, localhost 127.0.0.1)
TRUSTED_PROXY_IPS=127.0.0.1,172.16.0.0/12,10.0.0.0/8
